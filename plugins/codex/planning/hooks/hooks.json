{
  "hooks": {
    "Stop": [
      {"hooks": [{"type": "command", "command": "bash \"${PLUGIN_ROOT}/hooks/plan-continue.sh\"", "timeout": 10}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "bash \"${PLUGIN_ROOT}/hooks/proof-guard.sh\"", "timeout": 10}]}
    ],
    "SubagentStart": [
      {"hooks": [{"type": "command", "command": "bash \"${PLUGIN_ROOT}/hooks/dispatch-log.sh\"", "timeout": 5}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "bash \"${PLUGIN_ROOT}/hooks/dispatch-log.sh\"", "timeout": 5}]}
    ]
  }
}
